{
  "name": "dsh-todo-list",
  "version": "0.4.0",
  "description": "DeepSeek Harness plugin: a global todo list panel — add, edit, complete and delete tasks from anywhere in the harness, stored durably by the Host half",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "todo",
    "task",
    "list",
    "checklist"
  ],
  "license": "MIT",
  "author": "long0521",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddxl123/dsh-todo-list.git"
  },
  "homepage": "https://github.com/ddxl123/dsh-todo-list#readme",
  "bugs": {
    "url": "https://github.com/ddxl123/dsh-todo-list/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check src/index.js && node --check client/index.js && node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "plugin": {
      "title": "Todo list",
      "summary": "A global todo list panel: add, edit, complete and delete tasks from anywhere in the harness."
    }
  }
}
